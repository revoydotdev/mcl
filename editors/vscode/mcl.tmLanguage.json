{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MCL",
  "scopeName": "source.mcl",
  "patterns": [
    { "include": "#frontmatter-delim" },
    { "include": "#section-header" },
    { "include": "#comment" },
    { "include": "#constraint-tags" },
    { "include": "#signals" },
    { "include": "#block-keywords" },
    { "include": "#graph-keywords" },
    { "include": "#content-keywords" },
    { "include": "#type-annotations" },
    { "include": "#key-value-line" },
    { "include": "#list-item" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "frontmatter-delim": {
      "name": "keyword.control.frontmatter.mcl",
      "match": "^---\\s*$"
    },

    "section-header": {
      "match": "^(\\s*)(#)\\s+(──\\s*)?(State|Entities|Items|Actions|Transitions|Narrator|Knowledge|Constraints|Includes|Frontmatter)(\\s*──*)?\\s*$",
      "captures": {
        "2": { "name": "punctuation.definition.heading.mcl" },
        "3": { "name": "punctuation.decorator.mcl" },
        "4": { "name": "entity.name.section.mcl" },
        "5": { "name": "punctuation.decorator.mcl" }
      }
    },

    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mcl",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.mcl" }
          }
        },
        {
          "match": "(#)\\s+(?!──|State|Entities|Items|Actions|Transitions|Narrator|Knowledge|Constraints|Includes|Frontmatter).+$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.mcl" }
          },
          "name": "comment.line.hash.mcl"
        }
      ]
    },

    "constraint-tags": {
      "patterns": [
        {
          "name": "meta.tag.constraint.mcl",
          "begin": "(<)(/?)(tone|affect|practical|voice|constraint)(?=[\\s>\\/])",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.mcl" },
            "2": { "name": "punctuation.definition.tag.mcl" },
            "3": { "name": "entity.name.tag.constraint.mcl" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.mcl" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.mcl",
              "match": "([a-zA-Z_][a-zA-Z0-9_-]*)"
            },
            {
              "name": "keyword.operator.assignment.mcl",
              "match": "="
            },
            {
              "name": "string.quoted.double.attribute.mcl",
              "begin": "\"",
              "end": "\"",
              "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.mcl" } },
              "endCaptures": { "0": { "name": "punctuation.definition.string.end.mcl" } }
            },
            {
              "name": "string.quoted.single.attribute.mcl",
              "begin": "'",
              "end": "'",
              "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.mcl" } },
              "endCaptures": { "0": { "name": "punctuation.definition.string.end.mcl" } }
            },
            {
              "name": "punctuation.terminator.tag.mcl",
              "match": "\\/"
            }
          ]
        }
      ]
    },

    "signals": {
      "name": "meta.signal.mcl",
      "match": "\\b(MCL::)(action|mutate|transition|dialogue|narrate|query|noop|error)\\b",
      "captures": {
        "1": { "name": "keyword.control.namespace.mcl" },
        "2": { "name": "keyword.control.signal.mcl" }
      }
    },

    "block-keywords": {
      "match": "\\b(entity|action|narrator|item|transition|node|channel|memory|domain|template|import|extends|graph|signals|resolver|schema)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.mcl" }
      }
    },

    "graph-keywords": {
      "name": "keyword.other.graph.mcl",
      "match": "\\b(via)\\b"
    },

    "content-keywords": {
      "name": "keyword.control.content.mcl",
      "match": "\\b(when|requires|mutates|resolution|target|mode|knows|ignores|where|description)\\b"
    },

    "type-annotations": {
      "patterns": [
        {
          "match": "\\b(bool|int|float|string|any|map|signal|enum)\\b",
          "captures": {
            "1": { "name": "support.type.primitive.mcl" }
          }
        }
      ]
    },

    "key-value-line": {
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_.]*)(:)\\s",
      "captures": {
        "1": { "name": "variable.other.key.mcl" },
        "2": { "name": "punctuation.separator.key-value.mcl" }
      }
    },

    "list-item": {
      "match": "^\\s*(-)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(:)?",
      "captures": {
        "1": { "name": "punctuation.definition.list-item.mcl" },
        "2": { "name": "variable.other.list-item.mcl" },
        "3": { "name": "punctuation.separator.key-value.mcl" }
      }
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mcl",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.mcl" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.mcl" } },
          "patterns": [
            {
              "name": "constant.character.escape.mcl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric.mcl",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },

    "booleans": {
      "name": "constant.language.boolean.mcl",
      "match": "\\b(true|false|null)\\b"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.mcl",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.arrow.mcl",
          "match": "->"
        },
        {
          "name": "keyword.operator.constraint.mcl",
          "match": "[&|]"
        },
        {
          "name": "keyword.operator.assignment.mcl",
          "match": "="
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.mcl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.mcl",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.mcl",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.mcl",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.mcl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.mcl",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.mcl",
          "match": ","
        },
        {
          "name": "punctuation.separator.dot.mcl",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.mcl",
          "match": ":"
        },
        {
          "name": "keyword.operator.bang.mcl",
          "match": "!"
        }
      ]
    }
  }
}
